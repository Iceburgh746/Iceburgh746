diff --git a/App/driver/mb_flash.h b/App/driver/mb_flash.h
--- a/App/driver/mb_flash.h
+++ b/App/driver/mb_flash.h
@@
 #define MB_SLOT_MAGIC       0x31424D46u   /* "FMB1" */
 #define MB_HDR_VERSION      1u
 #define MB_FLAG_COMMITTED   (1u << 0)     /* image written and verified */
+#define MB_FLAG_FOREIGN     (1u << 1)     /* non-F4HWN PY32F071 application */
+#define MB_FLAG_RETURN_PATCHED (1u << 2)  /* informational: image carries a verified return hook */
 #define MB_NAME_LEN         16
 #define MB_VERSION_LEN      16
@@
     MB_ERR_SLOT,         /* slot or bank index out of range   */
     MB_ERR_AUTH,         /* write refused: timestamp mismatch */
-    MB_ERR_RAM_LOAD      /* restore stub RAM copy mismatch    */
+    MB_ERR_RAM_LOAD,     /* restore stub RAM copy mismatch    */
+    MB_ERR_VECTOR,       /* foreign image has invalid vectors */
+    MB_ERR_TARGET        /* foreign reset target is incompatible */
 };
diff --git a/App/driver/mb_flash.c b/App/driver/mb_flash.c
--- a/App/driver/mb_flash.c
+++ b/App/driver/mb_flash.c
@@
 #define MB_FLASH_PAGE   256u
+
+/* PY32F071xB memory geometry used to sanity-check imported/foreign images.
+ * F4HWN itself is linked at MB_INT_APP_BASE; a foreign slot must use the same
+ * application base and the MCU's 16 KiB SRAM window. */
+#define MB_SRAM_BASE    0x20000000u
+#define MB_SRAM_SIZE    0x00004000u
@@
 static uint8_t mb_read_header(uint8_t slot, mb_slot_header_t *hdr)
 {
@@
     return MB_OK;
 }
 
+/* Validate the two boot-critical ARM vector words of a foreign application.
+ *
+ * This deliberately runs on the radio, after the slot CRC check and before any
+ * internal-flash erase. Host-side validation is useful for UX but is not a
+ * safety boundary because a different host can call the slot API.
+ *
+ * A compatible PY32F071 UV-K1/K5V3 application must:
+ *  - start with an initial MSP inside 0x20000000..0x20004000;
+ *  - use a Thumb reset vector;
+ *  - point that reset handler into the supplied image at 0x08002800.
+ *
+ * This is intentionally a necessary-not-sufficient compatibility test. It
+ * rejects obviously wrong MCU/link layouts while leaving higher-level
+ * peripheral/config compatibility to the experimenter.
+ */
+static uint8_t mb_validate_foreign_vectors(uint8_t slot,
+                                           const mb_slot_header_t *hdr)
+{
+    const uint32_t slotBase = MB_SLOT0_EXT_BASE +
+                              (uint32_t)slot * MB_SLOT_STRIDE;
+    uint32_t vectors[2];
+
+    mb_spi_err = 0;
+    mb_ext_read(slotBase + MB_SLOT_IMG_OFFSET,
+                (uint8_t *)vectors, sizeof(vectors));
+    if (mb_spi_err)
+        return MB_ERR_SPI;
+
+    const uint32_t initial_sp = vectors[0];
+    const uint32_t reset_vec  = vectors[1];
+    const uint32_t reset_addr = reset_vec & ~1u;
+    const uint32_t image_end  = MB_INT_APP_BASE + hdr->image_size;
+
+    if (initial_sp < MB_SRAM_BASE ||
+        initial_sp > MB_SRAM_BASE + MB_SRAM_SIZE ||
+        (initial_sp & 0x3u) != 0u)
+        return MB_ERR_VECTOR;
+
+    if ((reset_vec & 1u) == 0u)
+        return MB_ERR_VECTOR;
+
+    if (reset_addr < MB_INT_APP_BASE || reset_addr >= image_end)
+        return MB_ERR_TARGET;
+
+    return MB_OK;
+}
+
 /* Validate one slot (header + image CRC-32), entirely via polled reads.
  * Never touches the internal flash. */
 static uint8_t mb_validate(uint8_t slot, mb_slot_header_t *hdr, uint32_t *crcOut)
@@
     if (crcOut)
         *crcOut = crc;
     if (mb_spi_err)                               return MB_ERR_SPI;
     if (crc != hdr->image_crc32)                  return MB_ERR_CRC;
+
+    if (hdr->flags & MB_FLAG_FOREIGN)
+    {
+        err = mb_validate_foreign_vectors(slot, hdr);
+        if (err != MB_OK)
+            return err;
+    }
+
     return MB_OK;
 }
diff --git a/App/ui/multiboot.c b/App/ui/multiboot.c
--- a/App/ui/multiboot.c
+++ b/App/ui/multiboot.c
@@
         case MB_ERR_SLOT:          return "bad index";
         case MB_ERR_AUTH:          return "auth";
         case MB_ERR_RAM_LOAD:      return "RAM LOAD ERROR";
+        case MB_ERR_VECTOR:        return "bad vectors";
+        case MB_ERR_TARGET:        return "wrong target";
         default:                   return "error";
     }
 }

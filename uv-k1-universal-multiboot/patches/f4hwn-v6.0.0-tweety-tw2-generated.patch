diff --git a/App/driver/mb_flash.c b/App/driver/mb_flash.c
index 05fd6a5..e795f91 100644
--- a/App/driver/mb_flash.c
+++ b/App/driver/mb_flash.c
@@ -29,6 +29,10 @@
 /* Internal flash granularity (PY32F071xB): program & page-erase = 256 bytes. */
 #define MB_FLASH_PAGE   256u
 
+/* PY32F071xB SRAM geometry used for imported-image validation. */
+#define MB_SRAM_BASE    0x20000000u
+#define MB_SRAM_SIZE    0x00004000u
+
 /* External SPI flash chip-select is on PA3 (see driver/py25q16.c). */
 #define MB_CS_PIN       (1u << 3)
 
@@ -662,6 +666,40 @@ static uint8_t mb_read_header(uint8_t slot, mb_slot_header_t *hdr)
     return MB_OK;
 }
 
+/* Validate the boot-critical ARM vector words of a foreign application.
+ * This runs after CRC validation and before any internal-flash erase. */
+static uint8_t mb_validate_foreign_vectors(uint8_t slot,
+                                           const mb_slot_header_t *hdr)
+{
+    const uint32_t slotBase = MB_SLOT0_EXT_BASE +
+                              (uint32_t)slot * MB_SLOT_STRIDE;
+    uint32_t vectors[2];
+
+    mb_spi_err = 0;
+    mb_ext_read(slotBase + MB_SLOT_IMG_OFFSET,
+                (uint8_t *)vectors, sizeof(vectors));
+    if (mb_spi_err)
+        return MB_ERR_SPI;
+
+    const uint32_t initial_sp = vectors[0];
+    const uint32_t reset_vec  = vectors[1];
+    const uint32_t reset_addr = reset_vec & ~1u;
+    const uint32_t image_end  = MB_INT_APP_BASE + hdr->image_size;
+
+    if (initial_sp < MB_SRAM_BASE ||
+        initial_sp > MB_SRAM_BASE + MB_SRAM_SIZE ||
+        (initial_sp & 0x3u) != 0u)
+        return MB_ERR_VECTOR;
+
+    if ((reset_vec & 1u) == 0u)
+        return MB_ERR_VECTOR;
+
+    if (reset_addr < MB_INT_APP_BASE || reset_addr >= image_end)
+        return MB_ERR_TARGET;
+
+    return MB_OK;
+}
+
 /* Validate one slot (header + image CRC-32), entirely via polled reads.
  * Never touches the internal flash. */
 static uint8_t mb_validate(uint8_t slot, mb_slot_header_t *hdr, uint32_t *crcOut)
@@ -678,6 +716,14 @@ static uint8_t mb_validate(uint8_t slot, mb_slot_header_t *hdr, uint32_t *crcOut
         *crcOut = crc;
     if (mb_spi_err)                               return MB_ERR_SPI;
     if (crc != hdr->image_crc32)                  return MB_ERR_CRC;
+
+    if (hdr->flags & MB_FLAG_FOREIGN)
+    {
+        err = mb_validate_foreign_vectors(slot, hdr);
+        if (err != MB_OK)
+            return err;
+    }
+
     return MB_OK;
 }
 
